# IntelliTransit Environment Configuration Template
FLASK_ENV=development
FLASK_APP=backend.run
SECRET_KEY=intellitransit-dev-secret-key-change-in-production-32chars

# Database Configuration (PostgreSQL 14+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intellitransit
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=20

# JWT Authentication
JWT_SECRET_KEY=intellitransit-jwt-secret-key-super-secure-change-in-prod-256bit
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_ALGORITHM=HS256

# OpenTripPlanner 2 Configuration
OTP_BASE_URL=http://localhost:8080
OTP_ROUTER_ID=default
OTP_TIMEOUT_SECONDS=10

# External AI Service (Gemini 2.5 Flash - Optional; local demo fallback used when absent)
GEMINI_API_KEY=

# Application Configuration
PUNE_BOUNDS_MIN_LAT=18.35
PUNE_BOUNDS_MAX_LAT=18.70
PUNE_BOUNDS_MIN_LNG=73.65
PUNE_BOUNDS_MAX_LNG=74.05
RATE_LIMIT_PER_MINUTE=60
